import os
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

TOKEN = os.environ["TELEGRAM_BOT_TOKEN"]

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    texto = """Boa tarde meu amor, veio ver sua vendedora favorita né 😈

É isso mesmo, hoje você vai poder ter acesso ao meu outro lado... mas não é pra qualquer um Amor, no meu grupo privado posto várias fotinhos e vídeos sem censura pra você, do jeito que você gosta ❤️

--------------------------------------

🌶️ Dentro do meu grupinho VIP, você vai ver sua vendedora de um jeito que você nunca mais vai esquecer 👇🏼"""

    await update.message.reply_text(texto)

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.run_polling()

if __name__ == "__main__":
    main()
